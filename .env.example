# ── Supabase ────────────────────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=demandu-verify-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Google (Calendar) ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI providers (pluggable / BYOK). Demandu AI = Voyage + Anthropic ─────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Traductor del chat (Cloud Translation API del mismo proyecto de Google)
GOOGLE_TRANSLATE_API_KEY=
